// MAX30105 heart-rate test (SparkFun Particle Sensor Breakout) - Arduino Uno
// Uses all three LEDs (red, IR, green). Green drives beat detection by default,
// since green is what works best on the wrist; IR is used to detect skin contact.
//
// Wiring (Uno):  5V -> 5V   GND -> GND   SDA -> A4   SCL -> A5   (INT not used)

#include <Arduino.h>
#include <Wire.h>
#include "MAX30105.h"
#include "heartRate.h"

MAX30105 sensor;

// ---- Settings to tune -------------------------------------------------------
// 1 = detect beats on the green channel (wrist), 0 = use IR (fingertip)
#define USE_GREEN_FOR_BEATS 1

// IR level above which we assume skin is on the sensor. Watch the IR value
// with and without contact and set this between the two.
const long CONTACT_THRESHOLD = 50000;

// Sensor configuration
const byte LED_BRIGHTNESS = 0x7F;  // 0x00-0xFF, 0x7F ~ 25 mA (wrist needs more light)
const byte SAMPLE_AVERAGE = 4;     // 1, 2, 4, 8, 16, 32
const byte LED_MODE       = 3;     // 3 = red + IR + green
const int  SAMPLE_RATE    = 400;   // 400 Hz / 4 averaged = 100 samples/s
const int  PULSE_WIDTH    = 411;   // longest pulse = 18-bit resolution
const int  ADC_RANGE      = 16384; // wider range so a bright LED doesn't saturate

// Print every Nth sample (raise this if the serial output can't keep up)
const byte PRINT_EVERY = 1;
// -----------------------------------------------------------------------------

const byte RATE_SIZE = 4;  // number of beats averaged for the displayed BPM
byte rates[RATE_SIZE];
byte rateSpot = 0;
byte ratesFilled = 0;
unsigned long lastBeat = 0;
float bpm = 0;
int avgBpm = 0;
byte printCounter = 0;

void resetAverage() {
  rateSpot = 0;
  ratesFilled = 0;
  avgBpm = 0;
  bpm = 0;
}

void handleBeat(unsigned long now) {
  unsigned long delta = now - lastBeat;
  lastBeat = now;
  bpm = 60.0 / (delta / 1000.0);

  // Ignore physiologically impossible values (missed or double-counted beats)
  if (bpm < 30 || bpm > 220) return;

  rates[rateSpot] = (byte)bpm;
  rateSpot = (rateSpot + 1) % RATE_SIZE;
  if (ratesFilled < RATE_SIZE) ratesFilled++;

  int sum = 0;
  for (byte i = 0; i < ratesFilled; i++) sum += rates[i];
  avgBpm = sum / ratesFilled;
}

void processSample(long red, long ir, long green) {
  bool contact = ir > CONTACT_THRESHOLD;

  if (contact) {
    long beatSignal = USE_GREEN_FOR_BEATS ? green : ir;
    if (checkForBeat(beatSignal)) handleBeat(millis());
  } else {
    resetAverage();
  }

  if (++printCounter >= PRINT_EVERY) {
    printCounter = 0;
    Serial.print(F("Red="));    Serial.print(red);
    Serial.print(F(" IR="));    Serial.print(ir);
    Serial.print(F(" Green=")); Serial.print(green);
    Serial.print(F(" BPM="));   Serial.print(bpm, 1);
    Serial.print(F(" Avg="));   Serial.print(avgBpm);
    if (!contact) Serial.print(F("  (no contact)"));
    Serial.println();
  }
}

void setup() {
  Serial.begin(115200);
  Serial.println(F("MAX30105 heart-rate test (red/IR/green)"));

  if (!sensor.begin(Wire, I2C_SPEED_FAST)) {
    Serial.println(F("MAX30105 not found - check wiring and power."));
    while (true) {}
  }

  sensor.setup(LED_BRIGHTNESS, SAMPLE_AVERAGE, LED_MODE,
               SAMPLE_RATE, PULSE_WIDTH, ADC_RANGE);
  sensor.setPulseAmplitudeGreen(0xFF);   // green at max (50 mA) - test only

  Serial.println(F("Sensor ready. Place it on your wrist or fingertip."));
}

void loop() {
  // Read every new sample in the FIFO so red, IR and green come from the
  // same sample and none are skipped.
  sensor.check();
  while (sensor.available()) {
    processSample(sensor.getFIFORed(), sensor.getFIFOIR(), sensor.getFIFOGreen());
    sensor.nextSample();
  }
}
